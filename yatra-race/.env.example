PORT=3000
# Optional but recommended for durable rooms and match recovery:
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Set to true if your database provider requires SSL (Neon typically does).
PGSSL=true
# Set a strong random secret in production; used to sign reconnect tokens.
TOKEN_SECRET=replace-with-a-long-random-secret
# Comma-separated allowed origins in production, e.g. https://your-app.vercel.app
ALLOWED_ORIGINS=
